{
  // This file tells Cloudflare Workers how to run our Next.js app.
  // The "main" points to the OpenNext worker entry point.
  // D1 binding gives our app access to the database.
  "name": "qacademy-beta-b",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Placeholder vars for local dev — real values live as Cloudflare secrets.
  // These entries satisfy the type system so TypeScript doesn't complain
  // about missing properties on CloudflareEnv during local builds.
  "vars": {
    "AUTH_SECRET": "",
    "AUTH_GOOGLE_ID": "",
    "AUTH_GOOGLE_SECRET": "",
    "AUTH_MICROSOFT_ENTRA_ID_ID": "",
    "AUTH_MICROSOFT_ENTRA_ID_SECRET": "",
    "AUTH_MICROSOFT_ENTRA_ID_TENANT_ID": "",
    "RESEND_API_KEY": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beta_b_db",
      "database_id": "e3d2f697-8bb3-4bf1-bc81-ebda379e1919"
    }
  ]
}
